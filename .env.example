# Postgres connection string (Supabase: Project Settings → Database → Connection string).
# Leave empty to use an embedded PGlite database stored in ./.data (local dev only).
DATABASE_URL=

# OpenAI. Without a key the app falls back to the deterministic planner and templated answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Signs session cookies and trip magic links. Required in production, 32+ chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Admins are real accounts now: npm run admin:create -- you@example.com "Your Name"

# Public base URL used in notification links.
APP_URL=http://localhost:3000

# Shared secret for /api/payments/webhook (HMAC-SHA256 of the raw body, hex, in x-signature).
PAYMENT_WEBHOOK_SECRET=

# Lead response targets: accept/decline within LEAD_RESPONSE_HOURS, quote within QUOTE_DUE_HOURS
# of accepting. Missed targets show up in the admin "Missed response targets" queue.
LEAD_RESPONSE_HOURS=2
QUOTE_DUE_HOURS=24
# Hours before an unanswered lead expires automatically.
LEAD_EXPIRY_HOURS=24

# Deposit the customer pays the operator to confirm a booking (INR).
DEPOSIT_AMOUNT=5000
