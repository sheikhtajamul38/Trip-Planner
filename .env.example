# Postgres connection string (Supabase: Project Settings → Database → Connection string).
# Leave empty to use an embedded PGlite database stored in ./.data (local dev only).
DATABASE_URL=

# OpenAI. Without a key the app falls back to the deterministic planner and templated answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Signs session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Password for the platform admin dashboard at /admin.
ADMIN_PASSWORD=change-me

# Public base URL used in notification links.
APP_URL=http://localhost:3000

# Shared secret for /api/payments/webhook (HMAC-SHA256 of the raw body, hex, in x-signature).
PAYMENT_WEBHOOK_SECRET=

# Hours before an unanswered lead expires.
LEAD_EXPIRY_HOURS=24
